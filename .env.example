# -------------------------------------------------------------
# High Skill Taekwondo Academy - Environment Configuration
# -------------------------------------------------------------

# Backend Server Port
PORT=5000

# MongoDB Connection URI (Local or MongoDB Atlas)
# Example local: mongodb://127.0.0.1:27017/high_skill_taekwondo
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/high_skill_taekwondo?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/high_skill_taekwondo

# JWT Secret Key for Admin Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production_123456

# Admin Dashboard Login Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
